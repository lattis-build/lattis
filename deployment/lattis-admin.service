[Unit]
Description=Lattis Admin through protected release launcher
After=network-online.target lattis-runner.service
Wants=network-online.target lattis-runner.service

[Service]
Type=simple
User=lattis-runtime
Group=lattis-runtime
SupplementaryGroups=lattis-runner
Environment=NODE_ENV=production
EnvironmentFile=/etc/lattis/runtime.env
UnsetEnvironment=NODE_OPTIONS NODE_PATH
ExecStart=/usr/bin/node /opt/lattis-updater/lattis-updater.mjs run admin
Restart=on-failure
TimeoutStopSec=45
KillMode=control-group
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/lattis-home-runtime
UMask=0077

[Install]
WantedBy=multi-user.target
