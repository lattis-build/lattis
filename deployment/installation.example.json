{
  "schemaVersion": 1,
  "applicationId": "lattis-home",
  "localPublisher": "lattis",
  "releaseDirectory": "/srv/lattis-home/releases",
  "stateDirectory": "/var/lib/lattis-home-updater",
  "ownerKeys": {},
  "ownerThreshold": 2,
  "allowDownloadedExecution": false,
  "edgeProtection": {
    "configurationDigest": "sha256:REPLACE_WITH_REVIEWED_EDGE_CONFIGURATION_DIGEST",
    "mode": "blocking",
    "originIsolated": true
  },
  "runner": {
    "socketPath": "/run/lattis-runner/runner.sock",
    "executablePath": "/opt/lattis-runner/extension-runner.mjs",
    "digest": "sha256:REPLACE_WITH_AUTHORIZED_PLATFORM_RUNNER_DIGEST"
  }
}
