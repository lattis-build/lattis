APP_DATABASE_URL=postgres://lattis:change-me@localhost:5432/lattis_app
# W produkcji: osobne konto migracji z DDL, używane tylko przez db:app/db:auth/db:admin/db:project.
# Adres i baza powinny wskazywać ten sam serwer/schemat co APP_DATABASE_URL; użytkownik musi być inny.
APP_MIGRATION_DATABASE_URL=
# W produkcji: CA serwera bazy z zaufanego źródła. MariaDB wymaga DNS w obu URL
# i certyfikatu z odpowiadającym mu SAN DNS. Samo wgranie CA nie naprawia braku SAN.
APP_DATABASE_CA_FILE=
LATTIS_MEDIA_DIR=./.lattis/media
LATTIS_VIDEO_DIR=./.lattis/videos
LATTIS_VIDEO_MAX_BYTES=2147483648
LATTIS_VIDEO_PLAYBACK_RETENTION_DAYS=30
LATTIS_VIDEO_ATTRIBUTION_KEY=
LATTIS_FFPROBE_BIN=
LATTIS_FFMPEG_BIN=
LATTIS_SHAKA_PACKAGER_BIN=
# Opcjonalny dziennik audytu immudb (serwer z włączonym protokołem PostgreSQL).
LATTIS_IMMUDB_URL=
LATTIS_IMMUDB_MIGRATION_URL=
LATTIS_IMMUDB_CA_FILE=
LATTIS_IMMUDB_NAMESPACE=
LATTIS_AUDIT_HMAC_KEY=
# Alternatywnie dla instancji aplikacji: mariadb://lattis:change-me@localhost:3306/lattis_app
GEODE_DATABASE_URL=postgres://lattis:change-me@localhost:5432/lattis_geode
BETTER_AUTH_SECRET=replace-with-random-secret-at-least-32-characters
APP_BASE_URL=http://127.0.0.1:4100
APP_PORT=4100
APP_HOST=127.0.0.1
# Optional application workspace MCP, served behind an HTTPS reverse proxy.
LATTIS_MCP_PUBLIC_URL=
LATTIS_MCP_PORT=4301
LATTIS_MCP_HOST=127.0.0.1
LATTIS_MCP_ALLOWED_ORIGINS=
LATTIS_MCP_EDIT_ROOTS=extensions,packages/local,src,web,docs,migrations,lattis.config.json,package.json,tsconfig.json
# Optional Lattis owner/admin panel on its own origin; white-label customer panels are separate apps.
LATTIS_ADMIN_BASE_URL=
LATTIS_ADMIN_PORT=4300
LATTIS_ADMIN_HOST=127.0.0.1
# Independent 32-byte Base64 master key for encrypted secrets entered in the panel.
LATTIS_VAULT_KEY=
# Server public URL; clients use the pinned official source by default.
GEODE_BASE_URL=https://geode.lattis.build
LATTIS_REGISTRY_MODE=official
# Development only: LATTIS_REGISTRY_MODE=development
# GEODE_DEVELOPMENT_URL=http://127.0.0.1:4200
# LATTIS_DEVELOPMENT_REGISTRY_POLICY=/absolute/path/development-trust.json
GEODE_PORT=4200
GEODE_HOST=127.0.0.1
GEODE_MCP_HOST=127.0.0.1
GEODE_MCP_PORT=4201
GEODE_MCP_PUBLIC_URL=http://127.0.0.1:4201/mcp
GEODE_MCP_ALLOWED_ORIGINS=http://127.0.0.1:4201
GEODE_OAUTH_ISSUER=
GEODE_OAUTH_JWKS_URL=
GEODE_OAUTH_AUDIENCE=
GEODE_OAUTH_OWNER_SUBJECT=
GEODE_ARTIFACT_DIR=./geode-artifacts
LATTIS_OWNER_EMAIL=owner@example.test
LATTIS_SIGNUP_OPEN=false
LATTIS_TRUSTED_ORIGINS=http://127.0.0.1:3000
LATTIS_TRUSTED_PROXY_CIDRS=
LATTIS_MAIL_WEBHOOK_URL=
LATTIS_MAIL_WEBHOOK_TOKEN=
# Tylko dla migracji haseł WordPress: 32 losowe bajty zakodowane base64 i absolutna ścieżka do PHP CLI.
LATTIS_WP_IMPORT_KEY=
LATTIS_PHP_BIN=
LATTIS_SECRET_PROVIDER_URL=
LATTIS_SECRET_PROVIDER_TOKEN=
GEODE_PUBLISHER_SLUG=owner
GEODE_API_TOKEN=

# Development expression runner: node runner/extension-runner.mjs. Production uses protected installation.json.
LATTIS_RUNNER_SOCKET=/run/lattis-runner/runner.sock
