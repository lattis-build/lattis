{
  "schemaVersion": 1,
  "kind": "node",
  "name": "@lattis/paynow",
  "version": "0.1.0",
  "description": "Optional Paynow v3 payment adapter with durable intent, reconciliation and signed notifications",
  "coreCompatibility": ">=0.2.0-alpha.1 <0.3.0",
  "databaseDialects": [
    "postgres",
    "mariadb"
  ],
  "files": [
    "index.ts",
    "client.ts",
    "pii.ts",
    "worker.ts",
    "webhook.ts",
    "migrations/001.sql",
    "migrations/001.mariadb.sql",
    "migrations/002.sql",
    "migrations/002.mariadb.sql",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {},
  "capabilities": [
    "outbound:paynow-v3",
    "payment-intents"
  ],
  "secrets": [
    "PAYNOW_PII_KEY"
  ],
  "actions": [
    "paynow.payment.create",
    "paynow.payment.read"
  ],
  "connections": [
    {
      "from": "lattis.paynow.payment.for-sale",
      "to": "lattis.commerce.sale.get",
      "kind": "invokes"
    },
    {
      "from": "lattis.paynow.payment.for-sale",
      "to": "lattis.paynow.payment.request",
      "kind": "invokes"
    },
    {
      "from": "lattis.paynow.payment.for-sale",
      "to": "lattis.commerce.sale.link",
      "kind": "invokes"
    },
    {
      "from": "lattis.paynow.payment.request",
      "to": "process:paynow-worker",
      "kind": "queues"
    },
    {
      "from": "process:paynow-worker",
      "to": "external:paynow-api",
      "kind": "outbound"
    },
    {
      "from": "external:paynow-api",
      "to": "process:paynow-webhook",
      "kind": "processes"
    }
  ],
  "nodes": [
    {
      "name": "lattis.paynow.payment.request",
      "kind": "command",
      "inputSchema": {},
      "outputSchema": {},
      "idempotent": true
    },
    {
      "name": "lattis.paynow.payment.for-sale",
      "kind": "command",
      "inputSchema": {},
      "outputSchema": {},
      "idempotent": true
    },
    {
      "name": "lattis.paynow.payment.get",
      "kind": "query",
      "inputSchema": {},
      "outputSchema": {},
      "idempotent": true
    }
  ],
  "routes": [],
  "migrations": [
    {
      "id": "paynow_001",
      "path": "migrations/001.sql",
      "mariadbPath": "migrations/001.mariadb.sql",
      "phase": "expand"
    },
    {
      "id": "paynow_002",
      "path": "migrations/002.sql",
      "mariadbPath": "migrations/002.mariadb.sql",
      "phase": "expand"
    }
  ],
  "license": {
    "identifier": "MIT"
  }
}
