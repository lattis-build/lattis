{
  "openapi": "3.1.0",
  "info": {
    "title": "Lattis Geode API",
    "version": "0.3.0-alpha.1",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4200"
    }
  ],
  "paths": {
    "/v1/packages": {
      "get": {
        "summary": "Search packages",
        "responses": {
          "200": {
            "description": "Packages"
          }
        }
      }
    },
    "/v1/packages/{name}": {
      "get": {
        "summary": "Package metadata",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Package"
          }
        }
      }
    },
    "/v1/packages/{name}/versions/{version}": {
      "get": {
        "summary": "Version metadata and signature",
        "responses": {
          "200": {
            "description": "Version"
          }
        }
      }
    },
    "/v1/packages/{name}/versions/{version}/artifact": {
      "get": {
        "summary": "Download permitted artifact",
        "responses": {
          "200": {
            "description": "Artifact"
          },
          "403": {
            "description": "Entitlement required"
          }
        }
      }
    },
    "/v1/packages/publish": {
      "post": {
        "summary": "Publish signed immutable version",
        "responses": {
          "201": {
            "description": "Published"
          }
        }
      }
    },
    "/v1/packages/{name}/offers": {
      "post": {
        "summary": "Create offer metadata",
        "responses": {
          "201": {
            "description": "Offer"
          }
        }
      }
    },
    "/v1/packages/{name}/entitlements": {
      "post": {
        "summary": "Grant access manually",
        "responses": {
          "201": {
            "description": "Entitlement"
          }
        }
      }
    },
    "/v1/packages/{name}/versions/{version}/revoke": {
      "post": {
        "summary": "Revoke version",
        "responses": {
          "200": {
            "description": "Revoked"
          }
        }
      }
    }
  }
}
