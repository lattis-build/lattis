            "minItems": 0
          },
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MigrationLink"
            },
            "maxItems": 500,
            "minItems": 0
          }
        },
        "additionalProperties": false
      },
      "MigrationContentBatch": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "source": {
            "$ref": "#/components/schemas/MigrationSource"
          },
          "importKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "expectedCursor": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 191
          },
          "nextCursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 191,
            "description": "Distinct checkpoint for every batch, including the last. Never reset to null."
          },
          "types": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContentType"
            },
            "maxItems": 100,
            "minItems": 0
          },
          "terms": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MigrationTerm"
            },
            "maxItems": 500,
            "minItems": 0
          },
          "media": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MigrationMedia"
            },
            "maxItems": 500,
            "minItems": 0
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MigrationContent"
            },
            "maxItems": 100,
            "minItems": 0
          }
        },
        "required": [
          "schemaVersion",
          "source",
          "importKey",
          "expectedCursor",
          "nextCursor",
          "items"
        ],
        "additionalProperties": false,
        "description": "Atomic batch. At least one record or type is required. Omitted links/terms/author preserve current associations; explicit empty arrays or null author clear them. Missing related records reject the batch. Duplicate source IDs reject the batch. Slugs must be mapped by the connector; conflicts are not silently renamed."
      },
