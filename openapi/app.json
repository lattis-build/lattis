            "minItems": 1
          }
        },
        "required": [
          "schemaVersion",
          "source",
          "importKey",
          "expectedCursor",
          "nextCursor",
          "users"
        ],
        "additionalProperties": false,
        "description": "Roles are preserved as source data only. Password migration needs an operator-controlled verifier with an allowed algorithm. Imported identities cannot replace an existing Lattis account."
      },
      "MigrationMediaUpload": {
        "type": "object",
        "properties": {
          "source": {
            "$ref": "#/components/schemas/MigrationSource"
