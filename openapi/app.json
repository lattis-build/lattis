                "$ref": "#/components/schemas/MigrationId"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "taxonomy",
          "slug",
          "label"
        ],
        "additionalProperties": false
      },
      "MigrationMedia": {
        "type": "object",
