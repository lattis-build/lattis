    "/api/manage/content/{id}": {
      "get": {
        "summary": "Read content including drafts",
        "responses": {
          "200": {
            "description": "Result"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Forbidden"
          },
          "409": {
            "description": "Conflict"
          }
        },
        "x-lattis-permission": "content.read:content"
      },
      "put": {
        "summary": "Replace content with expectedRevision",
        "responses": {
          "200": {
            "description": "Result"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Forbidden"
          },
          "409": {
            "description": "Conflict"
          }
        },
        "x-lattis-permission": "content.write:content",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "expectedRevision",
                  "content"
                ],
                "properties": {
                  "expectedRevision": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "content": {
                    "$ref": "#/components/schemas/ContentInput"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
