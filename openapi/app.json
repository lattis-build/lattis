          "displayName"
        ],
        "additionalProperties": false
      },
      "MigrationUserBatch": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "source": {
            "$ref": "#/components/schemas/MigrationSource"
          },
          "importKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "expectedCursor": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 191
          },
          "nextCursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 191,
