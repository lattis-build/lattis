              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "media"
                  },
                  "id": {
                    "$ref": "#/components/schemas/MigrationId"
                  }
                },
                "required": [
                  "kind",
                  "id"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "relation",
          "target"
        ],
        "additionalProperties": false
      },
      "MigrationContent": {
        "type": "object",
