                  "maxLength": 2048
                },
                "maxItems": 30,
                "minItems": 0
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        "required": [
          "source",
          "id",
          "mimeType",
          "sha256",
          "bytesBase64"
        ],
        "additionalProperties": false
