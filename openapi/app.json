          }
        }
      }
    },
    "/api/media/{id}/file": {
      "get": {
        "summary": "Serve a local file when linked to published content or authorized",
        "responses": {
          "200": {
            "description": "File"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "File not found"
          }
        }
      }
    },
    "/api/videos/{id}/file": {
      "put": {
        "summary": "Stream an MP4 upload into private storage",
        "x-lattis-permission": "video.manage:video",
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Video uploaded"
          },
          "400": {
            "description": "Hash or format mismatch"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Forbidden"
          },
          "409": {
            "description": "Upload conflict"
          },
          "413": {
            "description": "Too large"
          }
        }
      }
    },
    "/api/videos/{id}/playback": {
      "post": {
        "summary": "Create a player-neutral attributed playback session with HLS/DASH CMAF sources when packaged",
        "x-lattis-permission": "video.play:video",
        "responses": {
          "200": {
            "description": "Playback descriptor v1 with sources, protection and watermark policy"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Forbidden"
          },
          "501": {
            "description": "Required DRM or forensic watermark is unavailable"
          }
        }
      }
    },
    "/api/videos/{id}/playback/{playbackId}/packages/{packageId}/{path}": {
      "get": {
        "summary": "Serve a CMAF HLS/DASH manifest or segment within an authorized playback session",
        "x-lattis-permission": "video.play:video",
        "responses": {
          "200": {
            "description": "Manifest or segment"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Session or package unavailable"
          }
        }
      }
    },
    "/api/videos/{id}/stream": {
      "get": {
        "summary": "Stream an authorized playback with byte ranges",
        "x-lattis-permission": "video.play:video",
        "responses": {
          "200": {
            "description": "Full MP4"
          },
          "206": {
            "description": "MP4 byte range"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Forbidden"
          },
          "416": {
            "description": "Invalid range"
          }
        }
      }
    },
    "/lattis-video-player.js": {
      "get": {
        "summary": "Load the reusable Lattis video player web component",
        "responses": {
          "200": {
            "description": "JavaScript module"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ContentField": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "enum": [
              "text",
              "richtext",
              "number",
              "boolean",
              "date",
              "object",
              "array",
              "reference",
              "media",
              "json"
            ]
          },
          "required": {
            "type": "boolean",
            "default": false
          },
          "public": {
            "type": "boolean",
            "default": false
          }
        },
        "additionalProperties": false
      },
      "ContentType": {
        "type": "object",
        "required": [
          "key",
          "label",
          "fields"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContentField"
            }
          }
        },
        "additionalProperties": false
      },
      "ContentInput": {
        "type": "object",
        "required": [
          "type",
          "slug"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          },
          "status": {
            "enum": [
              "draft",
              "published",
              "archived"
            ]
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      },
      "ContentLink": {
        "type": "object",
        "required": [
          "relation",
          "targetKind",
          "targetRef"
        ],
        "properties": {
          "relation": {
            "type": "string"
          },
          "targetKind": {
            "enum": [
              "content",
              "node",
              "shard",
              "media",
              "external"
            ]
          },
          "targetRef": {
            "type": "string"
          },
          "position": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "WordPressBatch": {
        "type": "object",
        "required": [
          "site",
          "importKey",
          "expectedCursor",
          "nextCursor",
          "items"
        ],
        "properties": {
          "site": {
            "type": "string",
            "format": "uri"
          },
          "importKey": {
            "type": "string"
          },
          "expectedCursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "types": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "terms": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "media": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "required": [
                "id",
                "type",
                "slug",
                "status"
              ],
              "properties": {
                "id": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    }
                  ]
                },
                "type": {
                  "type": "string"
                },
                "slug": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                },
                "acf": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": false
      }
    }
  }
}
