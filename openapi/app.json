  "components": {
    "schemas": {
      "ContentField": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "enum": [
              "text",
              "richtext",
              "number",
              "boolean",
              "date",
              "object",
              "array",
              "reference",
              "media",
              "json"
            ]
          },
          "required": {
            "type": "boolean",
            "default": false
          },
          "public": {
            "type": "boolean",
            "default": false
          }
        },
        "additionalProperties": false
      },
      "ContentType": {
        "type": "object",
        "required": [
          "key",
          "label",
          "fields"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContentField"
            }
          }
        },
        "additionalProperties": false
      },
      "ContentInput": {
        "type": "object",
        "required": [
          "type",
          "slug"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          },
          "status": {
            "enum": [
              "draft",
              "published",
              "archived"
            ]
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      },
      "ContentLink": {
        "type": "object",
        "required": [
          "relation",
          "targetKind",
          "targetRef"
        ],
        "properties": {
          "relation": {
            "type": "string"
          },
          "targetKind": {
            "enum": [
              "content",
              "node",
              "shard",
              "media",
              "external"
            ]
          },
          "targetRef": {
            "type": "string"
          },
          "position": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "MigrationSource": {
        "type": "object",
        "properties": {
          "system": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
          },
          "instance": {
            "type": "string",
            "minLength": 1,
            "maxLength": 191
          }
        },
        "required": [
          "system",
          "instance"
        ],
        "additionalProperties": false
      },
      "MigrationId": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 191
